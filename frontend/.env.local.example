# Copy this file to .env.local for local development.
# Browser requests always use the Next.js same-origin proxy. Do not configure a
# NEXT_PUBLIC_API_URL pointing directly at Render, because that splits cookies.
BACKEND_API_URL=http://localhost:8080
# Số hotline hiển thị trên thanh điều hướng; có thể dùng dạng 0901 234 567.
NEXT_PUBLIC_HOTLINE_NUMBER=

# cmd: cp .env.local.example .env.local
