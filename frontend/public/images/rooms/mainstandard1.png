dia/202507/25/1753437980-thai-bao-retreat-villa-soc-son-toan-canh-3.jpg","name":"thai-bao-retreat-villa-soc-son-toan-canh-3.jpg","extension":"jpg","mime":"image/jpeg","width":2048,"height":1364,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-07-25T17:06:23","updatedAt":"2025-07-25T17:06:23"},{"id":"97fa022e-7ff6-4c1b-8729-a26a49f6d306","type":"IMAGE","path":"/media/202507/25/1753437985-thai-bao-retreat-villa-soc-son-toan-canh-7.jpg","name":"thai-bao-retreat-villa-soc-son-toan-canh-7.jpg","extension":"jpg","mime":"image/jpeg","width":2048,"height":1364,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-07-25T17:06:26","updatedAt":"2025-07-25T17:06:26"}]}],"breadcrumbs":[{"id":null,"icon":"","url":"/homestay","title":"Homestay \u0026 Villas"},{"id":null,"icon":"","url":"/homestay/villa-ha-noi","title":"Hà Nội"},{"id":null,"icon":"","url":"/homestay/villa-soc-son","title":"Sóc Sơn"}],"rating":5,"reviews":1},"global":true,"published":true,"lastPublished":"2026-07-14T14:14:22.839518","createdAt":"2026-07-14T14:14:22.839518","updatedAt":"2026-07-14T14:14:22.839518"},{"id":"e13485dd-1f35-437a-95f3-fb4b88ea96d1","name":"","attributeSet":"","countryIds":null,"cityIds":null,"districtIds":null,"section":"","position":"","type":"HOMESTAY_SIDEBAR","language":"vi","visibility":"all","background":"white","size":"lg","style":{},"heading":{"variant":"left","tag":"h2","title":"","subTitle":""},"config":null,"data":{"homestayId":"63a670ce-eabc-4efe-9aa8-af7751b4b8ba","price":1500000,"unit":"NIGHT","rating":5,"reviews":1,"adultDefinition":"Trên 11 tuổi","childDefinition":"Từ 6 đến 11 tuổi","infantDefinition":"Dưới 6 tuổi"},"global":true,"published":true,"lastPublished":"2026-07-14T14:14:22.83952","createdAt":"2026-07-14T14:14:22.83952","updatedAt":"2026-07-14T14:14:22.839521"},{"id":"63d802eb-55d5-4fdb-811e-1d0d47802ced","name":"","attributeSet":"","countryIds":null,"cityIds":null,"districtIds":null,"section":"","position":"","type":"HOMESTAY_HIGHLIGHT","language":"vi","visibility":"all","background":"white","size":"lg","style":{},"heading":{"variant":"left","tag":"h2","title":"","subTitle":""},"config":null,"data":{"type":"HOMESTAY","typeLabel":"Homestay","totalBedrooms":1,"totalBeds":1,"futons":null,"totalBathrooms":1,"totalKitchens":0,"totalOfRestrooms":1,"standardGuest":2,"maximumGuest":3,"usps":[{"icon":"OVEN","title":"Quy định nấu ăn","description":"Homestay có đầy đủ tiện nghi để bạn có thể tự nấu nướng"},{"icon":"PAYMENT","title":"Quy trình thanh toán","description":"Đặt cọc 50% tiền phòng, thanh toán phần còn lại và các phụ thu phát sinh khác khi checkin"},{"icon":"CLOCK","title":"Check-in/Check-out","description":"Check-in sau 14:00 và check-out trước 12:00 ngày hôm sau"},{"icon":"HOMESTAY","title":"Cách thức nhận phòng","description":"Liên hệ quản gia trước 30 phút để làm thủ tục nhận phòng"}]},"global":true,"published":true,"lastPublished":"2026-07-14T14:14:22.839576","createdAt":"2026-07-14T14:14:22.839576","updatedAt":"2026-07-14T14:14:22.839576"},{"id":"5e81bf69-f2eb-43e2-b58b-77c3e51948bd","name":"","attributeSet":"","countryIds":null,"cityIds":null,"districtIds":null,"section":"","position":"","type":"HOMESTAY_DESCRIPTION_V2","language":"vi","visibility":"all","background":"white","size":"lg","style":{},"heading":{"variant":"left","tag":"h2","title":"Chi tiết chỗ ở","subTitle":""},"config":null,"data":{"description":"💚 Homestay Bung Bi tại Thái Bảo Retreat bên hồ Đồng Đò là lựa chọn hoàn hảo cho kỳ nghỉ nhẹ nhàng, thư giãn và chữa lành tâm hồn giữa rừng thông xanh mát","priceDescription":"🎄 Thiết kế mở với 2 mặt kính, View vườn\n\n 🛏 1 giường 1m6 • điều hòa\n\n🚽 1 WC khép kín\n\n💧 Ấm siêu tốc • giá treo quần áo • tủ lạnh mini\n\n🥩 Bếp nướng • bếp lẩu • dụng cụ nấu nướng • bàn ăn ngoài sân hiên\n\n🧂 Lưu ý: Home không trang bị gia vị nấu nướng\n\n🌿 Sân hiên thoáng đãng với ô che nắng nhiều tầng\n\n---\n\n**Tiện ích chung toàn khu:**\n\n🍀 Bể bơi chung\n\n🍀 Khuôn viên sống ảo với 1001 góc chụp siêu xinh\n\n🍀 2 Xe đạp đơn\n\n---\n\n👨‍👩‍👧‍👦 **Tiêu chuẩn lưu trú**\n\n- Tiêu chuẩn: 2 người lớn + 1 trẻ em \u003c 5tuổi\n- Tối đa: 3 người lớn\n- Phụ thu từ khách thứ 3: 200k/NL, 100k/TE 6-11 tuổi\n\n**⏰ Nhận phòng 14h, trả phòng 12h hôm sau**","suggestedJourney":"🗓 **Ngày 1 – Rời phố, về với Sóc Sơn**\n\n⏰ **14:00 – 15:00**\n\n🏡 **Check-in homestay/villa** – Ngắm view rừng/hồ, nghỉ ngơi thư giãn\n\n🔁 Nếu đến sớm hơn: ghé café check-in gần villa (U Lesa / Gisy / Blue Valley)\n\n⏰ **15:00 – 16:30**\n\n🏯 **Việt Phủ Thành Chương** – Kiến trúc cổ, không gian văn hóa\n\n🔁 Lựa chọn khác:\n\n• 🧘 **Chùa Đức Hậu** – Không gian thanh tịnh, ít khách, thích hợp thiền/yoga nhẹ\n\n• 🧱 **Bảo tàng Đạo Mẫu (Xuân Hinh)** – Kiến trúc độc bản từ 5 triệu ngói cổ\n\n⏰ **16:30 – 17:30**\n\n🌅 **Hồ Đồng Đò** – Chèo SUP, ngắm hoàng hôn\n\n🔁 Lựa chọn khác:\n\n• 🌲 **Thiên Phú Lâm** – Trải nghiệm rừng thông, zipline, chèo thuyền, check-in mô hình\n\n• 🏞 **Hồ Hàm Lợn** – Trekking, cắm trại, không gian thiên nhiên hoang sơ\n\n⏰ **17:30 – 19:00**\n\n🍽 **Ăn tối tại nhà hàng địa phương**\n\n• 🏞 **Hương Tràm** – Rộng rãi, view hồ, đặc sản gà đồi, cá hồ\n\n• 🌿 **Mộc Quán** – Không gian mộc, món Việt truyền thống, ấm cúng\n\n🍳 **Tự nấu tại villa** – Nếu không muốn ra ngoài, có thể đặt set BBQ (gà, bò, hải sản), lẩu cá hồ... quản gia sẽ chuẩn bị đầy đủ. \n\n⏰ **19:00 – 21:00**\n\n🔥 **Karaoke / xem phim / đốt lửa trại** – Không gian ấm cúng, vui vẻ\n\n⏰ **21:00 – 23:00**\n\n🛁 **Ngâm bồn, nghỉ ngơi** – Chill nhẹ, ngủ sớm\n\n-------\n\n🗓 **Ngày 2 – Sáng Sóc Sơn trong lành**\n\n⏰ **07:00 – 08:00**\n\n🚶‍♀️ **Tản bộ / yoga ngoài trời** – Đón bình minh, không khí trong lành\n\n⏰ **08:00 – 09:00**\n\n☕️ **Ăn sáng hoặc café gần homestay**\n\n• **Gần Lâm Trường**: Nhà Bên Rừng - U Lesa Retreat\n\n• **Gần hồ Đồng Đò**: Gisy Lake House\n\n• **Gần hồ Ban Tiện**: Đồi Llum\n\n• **Gần hồ Đồng Quan**: Blue Valley Cafe \u0026 Bistro\n\n⏰ **09:00 – 10:30**\n\n⛩ **Đền Sóc – Chùa Non Nước** – Tâm linh, truyền thuyết Thánh Gióng\n\n⏰ **10:30 – 11:30**\n\n🧳 **Về lại homestay, dọn đồ, nghỉ nhẹ**\n\n⏰ **12:00**\n\n🚗 **Check-out** – Kết thúc hành trình","specialNote":"📌 **Giá phòng hiển thị trên Justfly là giá tiêu chuẩn** – Chưa bao gồm phụ thu nếu số người vượt quá quy định.\n\n🌿 **Do đặc điểm vùng núi Sóc Sơn, khu vực homestay có thể có muỗi**. Quý khách nên mang theo kem hoặc xịt chống muỗi để phòng tránh.\n\n📞 **Vui lòng liên hệ quản gia trước ít nhất 1 ngày** để được hỗ trợ chuẩn bị chu đáo.\n\n🎒 **Nhớ kiểm tra kỹ hành lý \u0026 đồ cá nhân trước khi check-out** để tránh bỏ quên.","diningService":"🍳 Homestay cho phép nấu ăn và đã chuẩn bị đầy đủ bếp, xoong nồi, dụng cụ. Không thu thêm phí.","menus":[{"name":"Menu lẩu","images":[{"id":"115d299c-5719-4285-b781-4c38db16ca0a","type":"IMAGE","path":"/media/202509/25/1758780686-thai-bao-retreat-soc-son-menu-lau-1.jpg","name":"thai-bao-retreat-soc-son-menu-lau-1.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:27","updatedAt":"2025-09-25T13:11:27"},{"id":"99c212e6-670f-4841-80db-fbcef9a50a10","type":"IMAGE","path":"/media/202509/25/1758780687-thai-bao-retreat-soc-son-menu-lau-2.jpg","name":"thai-bao-retreat-soc-son-menu-lau-2.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:28","updatedAt":"2025-09-25T13:11:28"},{"id":"b69ff498-e5c8-4240-b5a9-6feab18421b3","type":"IMAGE","path":"/media/202509/25/1758780688-thai-bao-retreat-soc-son-menu-lau-4.jpg","name":"thai-bao-retreat-soc-son-menu-lau-4.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:29","updatedAt":"2025-09-25T13:11:29"},{"id":"01d96281-5f89-4e8b-95a7-a78d5e82077a","type":"IMAGE","path":"/media/202509/25/1758780688-thai-bao-retreat-soc-son-menu-lau-3.jpg","name":"thai-bao-retreat-soc-son-menu-lau-3.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:29","updatedAt":"2025-09-25T13:11:29"}]},{"name":"Menu nướng","images":[{"id":"79842410-df26-4d83-8e57-680dc30fd854","type":"IMAGE","path":"/media/202509/25/1758780676-thai-bao-retreat-soc-son-menu-nuong-1.jpg","name":"thai-bao-retreat-soc-son-menu-nuong-1.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:20","updatedAt":"2025-09-25T13:11:20"},{"id":"b6f4ea4c-47ee-43bc-b48f-d4ff06e17163","type":"IMAGE","path":"/media/202509/25/1758780684-thai-bao-retreat-soc-son-menu.jpg","name":"thai-bao-retreat-soc-son-menu.jpg","extension":"jpg","mime":"image/jpeg","width":1364,"height":2048,"alt":"","caption":"","author":"","tags":[],"createdAt":"2025-09-25T13:11:26","updatedAt":"2025-09-25T13:11:26"}]}],"modeOfTransportation":"🚗 Home có hỗ trợ đặt xe đưa đón cho khách  Chỉ cần báo trước thời gian và địa điểm, Home sẽ kết nối với tài xế uy tín để bạn di chuyển thuận tiện, không lo tìm xe. Bạn tham khảo bảng giá dưới đây nhé (giá có thể thay đổi tùy thời điểm, đặc biệt vào dịp lễ Tết...).","rentalCars":[{"name":"Sedan 4 chỗ","description":"3 người lớn, 3 vali nhỏ hoặc 2 vali cỡ trung","image":{"id":"acbe0d51-6443-47d5-9093-656bc418fc8f","type":"IMAGE","path":"/media/202410/23/1729692685-xe-4-cho.jpeg","name":"xe-4-cho.jpeg","extension":"jpeg","mime":"image/jpeg","width":225,"height":225,"alt":"","caption":"","author":"","tags":[],"createdAt":"2024-10-23T21:11:26","updatedAt":"2024-10-23T21:11:26"},"seats":4,"onewayPrice":500000,"returnPrice":500000,"roundTripPrice":1000000},{"name":"7 chỗ","description":"6 người lớn, 3-5 vali cỡ trung hoặc 2 vali lớn","image":{"id":"e4cf0ef4-e866-4f3a-9c3f-d812fb941e1e","type":"IMAGE","path":"/media/202410/23/1729692686-xe-7-cho.png","name":"xe-7-cho.png","extension":"png","mime":"image/png","width":600,"height":249,"alt":"","caption