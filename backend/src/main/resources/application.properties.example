spring.application.name=homestay-booking-backend

# ===== Database =====
# Either set the DB_* environment variables, or replace the values after the colon.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/homestaydb}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_postgres_password}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.format_sql=${JPA_FORMAT_SQL:false}
spring.sql.init.mode=never
spring.sql.init.platform=postgresql
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# ===== Mail =====
# Render Free blocks SMTP ports 25, 465 and 587. Use an SMTP relay that supports
# port 2525 in production; Gmail 587 remains the local-development default.
spring.mail.protocol=${MAIL_PROTOCOL:smtp}
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS:true}
spring.mail.properties.mail.smtp.starttls.required=${MAIL_STARTTLS_REQUIRED:false}
spring.mail.properties.mail.smtp.ssl.enable=${MAIL_SSL_ENABLE:false}
# Used as the visible From address when the relay login is not an email address.
# The address must be verified by the selected mail provider.
spring.mail.properties.mail.from=${MAIL_FROM_ADDRESS:${MAIL_USERNAME:}}
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

server.port=${PORT:8080}
# Business timestamps are stored as local date-times. Keep the application clock
# independent from the host machine (Render uses UTC by default).
app.time-zone=${APP_TIME_ZONE:Asia/Ho_Chi_Minh}
spring.jackson.time-zone=${APP_TIME_ZONE:Asia/Ho_Chi_Minh}
spring.jpa.properties.hibernate.jdbc.time_zone=${APP_TIME_ZONE:Asia/Ho_Chi_Minh}
spring.datasource.hikari.connection-init-sql=SET TIME ZONE '${APP_TIME_ZONE:Asia/Ho_Chi_Minh}'
spring.servlet.multipart.max-file-size=12MB
spring.servlet.multipart.max-request-size=13MB

# JWT_SECRET is required and must be Base64 for at least 32 random bytes.
# PowerShell example: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
app.jwt.secret=${JWT_SECRET:}
app.jwt.access-token-expiration=${JWT_ACCESS_TOKEN_EXPIRATION:15m}
app.jwt.refresh-token-expiration=${JWT_REFRESH_TOKEN_EXPIRATION:7d}
app.jwt.absolute-session-expiration=${JWT_ABSOLUTE_SESSION_EXPIRATION:30d}

# Keep false for local HTTP development; set true behind HTTPS in production.
app.cookie.secure=${APP_COOKIE_SECURE:false}
app.security.csrf.enabled=${APP_SECURITY_CSRF_ENABLED:true}
# Public origin only (no /verify-email path). Example production value: https://stay.example.com
app.frontend.base-url=${APP_FRONTEND_BASE_URL:http://localhost:3000}
# Comma-separated exact origins. Never use credentialed wildcard origins in production.
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://127.0.0.1:3000}

# ===== Google OAuth2 =====
# Create a Web application client in Google Auth Platform. Never commit the real secret.
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:oauth-disabled-client}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:oauth-disabled-secret}
spring.security.oauth2.client.registration.google.scope=openid,profile,email
spring.security.oauth2.client.registration.google.redirect-uri=${OAUTH_REDIRECT_URI:http://localhost:3000/login/oauth2/code/google}
# ===== Facebook OAuth2 =====
spring.security.oauth2.client.registration.facebook.client-id=${FACEBOOK_CLIENT_ID:oauth-disabled-client}
spring.security.oauth2.client.registration.facebook.client-secret=${FACEBOOK_CLIENT_SECRET:oauth-disabled-secret}
spring.security.oauth2.client.registration.facebook.scope=email,public_profile
spring.security.oauth2.client.registration.facebook.redirect-uri=${FACEBOOK_OAUTH_REDIRECT_URI:${APP_FRONTEND_BASE_URL:http://localhost:3000}/login/oauth2/code/facebook}
spring.security.oauth2.client.provider.facebook.user-info-uri=https://graph.facebook.com/me?fields=id,name,email,picture.type(large)
spring.security.oauth2.client.provider.facebook.user-name-attribute=id
server.forward-headers-strategy=framework

# ===== Cloudinary =====
# Keep the API secret server-side only. The frontend uploads images through the backend.
cloudinary.url=${CLOUDINARY_URL:}
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
cloudinary.api-key=${CLOUDINARY_API_KEY:}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:}
cloudinary.folder=${CLOUDINARY_FOLDER:homestay-booking-management/rooms}
cloudinary.avatar-folder=${CLOUDINARY_AVATAR_FOLDER:homestay-booking-management/avatars}
cloudinary.refund-proof-folder=${CLOUDINARY_REFUND_PROOF_FOLDER:homestay-booking-management/refunds}
cloudinary.review-folder=${CLOUDINARY_REVIEW_FOLDER:homestay-booking-management/reviews}

# ===== VNPay =====
# Keep credentials in environment variables for local development and production.
payment.vnpay.tmn-code=${VNPAY_TMN_CODE:}
payment.vnpay.hash-secret=${VNPAY_HASH_SECRET:}
payment.vnpay.payment-url=${VNPAY_PAYMENT_URL:https://sandbox.vnpayment.vn/paymentv2/vpcpay.html}
payment.vnpay.return-url=${VNPAY_RETURN_URL:http://localhost:3000/payment/return}
payment.vnpay.version=2.1.0
payment.vnpay.command=pay
payment.vnpay.currency-code=VND
payment.vnpay.locale=vn

# ===== Gemini AI Chatbot =====
# Get a free developer API key from https://aistudio.google.com/app/apikey
gemini.ai.api-key=${GEMINI_AI_API_KEY:}
gemini.ai.model=${GEMINI_AI_MODEL:gemini-2.5-flash}
gemini.ai.base-url=${GEMINI_AI_BASE_URL:https://generativelanguage.googleapis.com/v1beta}
gemini.ai.max-output-tokens=${GEMINI_AI_MAX_OUTPUT_TOKENS:1200}
gemini.ai.temperature=${GEMINI_AI_TEMPERATURE:0.35}

# Hold an unpaid room slot for 5 minutes before releasing it.
app.booking.payment-expiration-seconds=${BOOKING_PAYMENT_EXPIRATION_SECONDS:300}
app.booking.expiry-sweep-interval-ms=${BOOKING_EXPIRY_SWEEP_INTERVAL_MS:10000}

# ===== SePay =====
# Online deposit flow redirects customers to the configured SePay/VietQR checkout URL.
# Configure the SePay webhook URL as: ${APP_PUBLIC_BACKEND_URL}/api/payments/sepay/webhook
# Payment Gateway IPN (dashboard: Payment Gateway -> Configuration -> IPN): choose auth type
# SECRET_KEY and set the same value in SEPAY_IPN_SECRET; SePay then sends it as X-Secret-Key.
# Prefer HMAC-SHA256 in production. API key is supported as a fallback for simpler setups.
# If checkout-url is blank, backend builds a VietQR image URL from the bank settings below.
# Sandbox portal: https://pay-sandbox.sepay.vn/v1/checkout/init | Production: https://pay.sepay.vn/v1/checkout/init
payment.sepay.checkout-url=${SEPAY_CHECKOUT_URL:}
payment.sepay.qr-bank-account=${SEPAY_QR_BANK_ACCOUNT:}
payment.sepay.qr-bank-code=${SEPAY_QR_BANK_CODE:}
payment.sepay.qr-template=${SEPAY_QR_TEMPLATE:compact}
# Frontend renders the VietQR image returned by POST /api/payments/sessions, then polls
# GET /api/payments/transactions/{paymentId}. When api-access-token is configured, that
# poll queries SePay userapi Transactions API v2 first, then falls back to the legacy v1
# endpoint, and syncs booking/payment status immediately.
payment.sepay.api-access-token=${SEPAY_API_ACCESS_TOKEN:}
# Optional: only set this to the v2 UUID bank_account_id. Leave blank when you only have
# the legacy numeric id; account-number is enough for matching.
payment.sepay.api-bank-account-id=${SEPAY_API_BANK_ACCOUNT_ID:}
payment.sepay.api-account-number=${SEPAY_API_ACCOUNT_NUMBER:}
payment.sepay.merchant-id=${SEPAY_MERCHANT_ID:}
payment.sepay.secret-key=${SEPAY_SECRET_KEY:}
payment.sepay.success-url=${SEPAY_SUCCESS_URL:http://localhost:3000/payment/return}
payment.sepay.error-url=${SEPAY_ERROR_URL:http://localhost:3000/payment/return}
payment.sepay.cancel-url=${SEPAY_CANCEL_URL:http://localhost:3000/payment/return}
payment.sepay.currency=${SEPAY_CURRENCY:VND}
payment.sepay.operation=${SEPAY_OPERATION:}
payment.sepay.method=${SEPAY_METHOD:}
payment.sepay.transaction-type=${SEPAY_TRANSACTION_TYPE:}
payment.sepay.portal-signature-param=${SEPAY_PORTAL_SIGNATURE_PARAM:signature}
# HMAC secret for the bank-transfer ("bien dong so du") webhook, which signs requests
# with X-SePay-Signature / X-SePay-Timestamp headers.
payment.sepay.webhook-hmac-secret=${SEPAY_WEBHOOK_HMAC_SECRET:}
payment.sepay.webhook-timestamp-tolerance-seconds=${SEPAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS:300}
# Secret for the Payment Gateway IPN (SePay portal: Payment Gateway -> Configuration -> IPN,
# auth type SECRET_KEY, sent back via the X-Secret-Key header). Must match the portal value,
# otherwise ORDER_PAID/ORDER_FAILED notifications are rejected and paid bookings never update.
payment.sepay.ipn-secret=${SEPAY_IPN_SECRET:}
